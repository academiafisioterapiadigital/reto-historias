// LOGIN
async function doLogin() {
  var email = document.getElementById('login-email').value.trim().toLowerCase();
  if (!email) return;
  var btn = document.getElementById('btn-login');
  var err = document.getElementById('login-error');
  btn.disabled = true; btn.textContent = 'Comprobando...'; err.style.display = 'none';
  var res = await db.from('alumnos').select('id,nombre,email,activo').eq('email',email).single();
  if (res.error || !res.data) {
    err.textContent = 'Este correo no está autorizado. Contacta con Cristina.';
    err.style.display = 'block'; btn.disabled = false; btn.textContent = 'Entrar'; return;
  }
  if (!res.data.activo) {
    err.textContent = 'Tu acceso está desactivado. Contacta con Cristina.';
    err.style.display = 'block'; btn.disabled = false; btn.textContent = 'Entrar'; return;
  }
  alumnoId = res.data.id;
  alumnoNombre = res.data.nombre;
  document.getElementById('user-name').textContent = res.data.nombre.split(' ')[0];
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('app-screen').style.display = 'block';
  buildBrolls();
  await cargarDestacadosEjercicio2();
  await cargarProgreso();
}

function doLogout() {
  alumnoId = null; alumnoNombre = ''; ejercicioId = null;
  document.getElementById('login-screen').style.display = 'flex';
  document.getElementById('app-screen').style.display = 'none';
  document.getElementById('login-email').value = '';
}

// CARGAR DESTACADOS DEL EJERCICIO 2
async function cargarDestacadosEjercicio2() {
  var res = await db.from('ejercicio_perfil_visible').select('destacados').eq('alumno_id', alumnoId).single();
  var destacadosBase = ['Empieza aquí','Sobre mí','Cómo trabajo','Método','Casos','Testimonios','Preguntas frecuentes','Recursos'];
  if (res.data && res.data.destacados && Object.keys(res.data.destacados).length > 0) {
    estado.destacados = Object.keys(res.data.destacados);
  } else {
    estado.destacados = destacadosBase;
  }
  renderDestacados();
}

function renderDestacados() {
  var cont = document.getElementById('destacados-container');
  cont.innerHTML = '';
  estado.destacados.forEach(function(d) {
    var tag = document.createElement('span');
    tag.className = 'destacado-tag';
    tag.dataset.nombre = d;
    tag.innerHTML = '<span class="check">✓</span> ' + d;
    tag.onclick = function() { toggleDestacadoTag(d, tag); };
    cont.appendChild(tag);
  });
}

function toggleDestacadoTag(nombre, el) {
  el.classList.toggle('inactive');
  scheduleAutosave();
}

function añadirDestacado() {
  var input = document.getElementById('nuevo-destacado');
  var val = input.value.trim();
  if (!val) return;
  estado.destacados.push(val);
  renderDestacados();
  input.value = '';
  scheduleAutosave();
}

function getDestacadosActivos() {
  var activos = [];
  document.querySelectorAll('.destacado-tag:not(.inactive)').forEach(function(t) {
    activos.push(t.dataset.nombre);
  });
  return activos;
}

// BROLLS
function buildBrolls() {
  var cont = document.getElementById('brolls-container');
  cont.innerHTML = '';
  brollsLista.forEach(function(b) {
    var div = document.createElement('div');
    div.className = 'broll-item';
    div.innerHTML = '<input type="checkbox" onchange="toggleBroll(\''+b+'\', this.checked)"> ' + b;
    cont.appendChild(div);
    div.onclick = function(e) {
      if (e.target.tagName !== 'INPUT') {
        var cb = div.querySelector('input');
        cb.checked = !cb.checked;
        toggleBroll(b, cb.checked);
      }
    };
  });
}

function toggleBroll(nombre, checked) {
  var div = document.querySelector('.broll-item input[onchange*="'+nombre.replace(/'/g,"\\'")+'"]');
  if (div) div.closest('.broll-item').classList.toggle('selected', checked);
  if (checked) { if (!estado.brolls.includes(nombre)) estado.brolls.push(nombre); }
  else { estado.brolls = estado.brolls.filter(function(b){ return b !== nombre; }); }
  scheduleAutosave();
  actualizarProgreso();
}

// CALENDARIO
function generarCalendario() {
  var fechaInput = document.getElementById('fecha_inicio').value;
  if (!fechaInput) return;
  var cont = document.getElementById('calendario-container');
  var fecha = new Date(fechaInput + 'T12:00:00');
  var html = '<div class="calendario-preview"><h4>📅 Tu calendario de 30 días</h4>';
  for (var i = 0; i < 15; i++) {
    var dia = new Date(fecha);
    dia.setDate(fecha.getDate() + (i * 2));
    var fechaStr = dia.toLocaleDateString('es-ES', {weekday:'short', day:'numeric', month:'short'});
    var a = angulos[i];
    var bloqueColor = i < 5 ? '#38ada9' : i < 10 ? '#5ab8b4' : '#7dd0ce';
    html += '<div class="cal-item">';
    html += '<div class="cal-dia" style="color:'+bloqueColor+'">Día '+(i*2+1)+'<br><span style="font-weight:400;color:#999">'+fechaStr+'</span></div>';
    html += '<div class="cal-angulo"><strong>'+a.angulo+'</strong><div class="cal-bloque">'+a.bloque+' · '+a.destacados+'</div></div>';
    html += '</div>';
  }
  html += '</div>';
  cont.innerHTML = html;
  actualizarProgreso();
}

// CARGAR PROGRESO
async function cargarProgreso() {
  var res = await db.from('ejercicio_reto_historias').select('*').eq('alumno_id', alumnoId).single();
  if (!res.data) return;
  ejercicioId = res.data.id;
  var d = res.data;
  var campos = ['paciente_quien','paciente_problema','paciente_intentado','por_que_este_paciente','indigna_del_sector','primer_paso_contigo','como_quieres_que_sienta','brolls_propios','historias_publicadas','formato_facil','formato_verguenza','alguien_respondio','historia_repetiria','idea_para_futuro','aprendizaje_resistencia'];
  campos.forEach(function(id) {
    var el = document.getElementById(id);
    if (el && d[id]) el.value = d[id];
  });
  if (d.destacados_confirmados && d.destacados_confirmados.length) {
    estado.destacados = d.destacados_confirmados;
    renderDestacados();
  }
  if (d.brolls_seleccionados && d.brolls_seleccionados.length) {
    estado.brolls = d.brolls_seleccionados;
    document.querySelectorAll('.broll-item').forEach(function(item) {
      var texto = item.textContent.trim();
      if (estado.brolls.includes(texto)) {
        item.classList.add('selected');
        item.querySelector('input').checked = true;
      }
    });
  }
  if (d.fecha_inicio) {
    document.getElementById('fecha_inicio').value = d.fecha_inicio;
    generarCalendario();
  }
  if (d.registro_completado) {
    document.getElementById('registro-locked').style.display = 'none';
  }
  actualizarProgreso();
  mostrarAutosave('guardado','Progreso recuperado ✓');
}

// GUARDAR
function scheduleAutosave() { clearTimeout(saveTimer); mostrarAutosave('guardando','Guardando...'); saveTimer = setTimeout(saveProgress, 1500); }

async function saveProgress() {
  if (!alumnoId) return;
  var registroTieneAlgo = v('historias_publicadas') || v('formato_facil') || v('aprendizaje_resistencia');
  var payload = {
    alumno_id: alumnoId,
    paciente_quien: v('paciente_quien'),
    paciente_problema: v('paciente_problema'),
    paciente_intentado: v('paciente_intentado'),
    por_que_este_paciente: v('por_que_este_paciente'),
    indigna_del_sector: v('indigna_del_sector'),
    primer_paso_contigo: v('primer_paso_contigo'),
    como_quieres_que_sienta: v('como_quieres_que_sienta'),
    destacados_confirmados: getDestacadosActivos(),
    brolls_seleccionados: estado.brolls,
    brolls_propios: v('brolls_propios'),
    fecha_inicio: document.getElementById('fecha_inicio').value || null,
    historias_publicadas: v('historias_publicadas') ? parseInt(v('historias_publicadas')) : null,
    formato_facil: v('formato_facil'),
    formato_verguenza: v('formato_verguenza'),
    alguien_respondio: v('alguien_respondio'),
    historia_repetiria: v('historia_repetiria'),
    idea_para_futuro: v('idea_para_futuro'),
    aprendizaje_resistencia: v('aprendizaje_resistencia'),
    registro_completado: !!registroTieneAlgo,
    porcentaje_completado: calcPct(),
    completado: calcPct() === 100,
  };
  var res;
  if (ejercicioId) {
    res = await db.from('ejercicio_reto_historias').update(payload).eq('id', ejercicioId);
  } else {
    res = await db.from('ejercicio_reto_historias').insert(payload).select('id').single();
    if (res.data) ejercicioId = res.data.id;
  }
  if (res.error) mostrarAutosave('error','Error al guardar. Revisa tu conexión.');
  else { mostrarAutosave('guardado','Guardado automáticamente ✓'); actualizarProgreso(); }
}

function v(id) { var el = document.getElementById(id); return el ? el.value : ''; }

function calcPct() {
  var ok = 0, total = 10;
  if (v('paciente_quien')) ok++;
  if (v('paciente_problema')) ok++;
  if (v('por_que_este_paciente')) ok++;
  if (v('indigna_del_sector')) ok++;
  if (v('como_quieres_que_sienta')) ok++;
  if (getDestacadosActivos().length) ok++;
  if (estado.brolls.length) ok++;
  if (v('brolls_propios')) ok++;
  if (document.getElementById('fecha_inicio').value) ok++;
  if (v('aprendizaje_resistencia')) ok++;
  return Math.round((ok/total)*100);
}

function actualizarProgreso() {
  var pct = calcPct();
  document.getElementById('progress-fill').style.width = pct+'%';
  document.getElementById('progress-pct').textContent = pct+'%';
}

function mostrarAutosave(est, texto) {
  document.getElementById('autosave-bar').className = 'autosave-bar ' + est;
  document.getElementById('autosave-text').textContent = texto;
}

// NAVEGACIÓN
function goTo(viewId) {
  document.querySelectorAll('.view').forEach(function(v){ v.classList.remove('active'); });
  document.getElementById(viewId).classList.add('active');
  var idx = viewOrder.indexOf(viewId);
  document.querySelectorAll('.step-item').forEach(function(s,i){
    s.classList.remove('active','done');
    if(i===idx) s.classList.add('active');
    else if(i<idx) s.classList.add('done');
  });
  if (viewId === 'view-registro') {
    var tieneRegistro = v('historias_publicadas') || v('aprendizaje_resistencia');
    if (tieneRegistro) document.getElementById('registro-locked').style.display = 'none';
  }
  window.scrollTo({top:0,behavior:'smooth'});
  saveProgress();
}

